####### Compile

build/box.o: src/box.cpp include/box.h \
		include/point.h \
		include/core_global.h \
		include/vector.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/box.o src/box.cpp

build/camera.o: src/camera.cpp include/camera.h \
		include/point.h \
		include/core_global.h \
		include/vector.h \
		include/box.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/camera.o src/camera.cpp

build/face.o: src/face.cpp include/face.h \
		include/vertex.h \
		include/point.h \
		include/core_global.h \
		include/vector.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/face.o src/face.cpp

build/object.o: src/object.cpp include/object.h \
		include/box.h \
		include/point.h \
		include/core_global.h \
		include/face.h \
		include/vertex.h \
		include/vector.h \
		include/scene.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/object.o src/object.cpp

build/point.o: src/point.cpp include/point.h \
		include/core_global.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/point.o src/point.cpp

build/scene.o: src/scene.cpp include/scene.h \
		include/object.h \
		include/box.h \
		include/point.h \
		include/core_global.h \
		include/face.h \
		include/vertex.h \
		include/vector.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/scene.o src/scene.cpp

build/vertex.o: src/vertex.cpp include/vertex.h \
		include/point.h \
		include/core_global.h \
		include/vector.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o build/vertex.o src/vertex.cpp

